{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "scenarios/**", "config/**", "tests/**", "scripts/**", "requirements.txt", "Dockerfile", "railway.json"]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
