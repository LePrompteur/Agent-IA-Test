# Copier en .env (non versionné) et compléter.
ANTHROPIC_API_KEY=

# Binaire Chromium si `python -m playwright install chromium` n'est pas possible.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/chemin/vers/chromium

# Application réelle à tester (scénarios ${APP_BASE_URL}). Sans cette variable, ils sont ignorés (SKIPPED).
APP_BASE_URL=
APP_USER_EMAIL=
APP_USER_PASSWORD=
# Chemins optionnels (valeurs par défaut entre parenthèses dans les scénarios)
# APP_WIZARD_PATH=/inscription
# APP_UPLOAD_PATH=/documents
# APP_SHOP_PATH=/boutique
# APP_CHECKOUT_PATH=/commande
# APP_SEARCH_PATH=/recherche
# APP_API_FLOW_PATH=/
# APP_DISCOUNT_CODE=

# Banc d'essai : démarré automatiquement si non défini.
# FIXTURE_BASE_URL=http://127.0.0.1:8765
